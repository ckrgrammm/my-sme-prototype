# Official Meta WhatsApp Business Platform credentials.
# Copy this file to server/.env — it is loaded automatically on server start.
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# The AI Operations Assistant (see OPERATIONS_ASSISTANT.md) is rule-based —
# no LLM API key or local model server needed. Nothing to configure here.
